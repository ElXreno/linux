&bluetooth {
	firmware-name = "crnv21.bin", "crbtfw21.tlv";
};

&gpu {
	zap-shader {
		firmware-name = "qcom/sm7150/xiaomi/courbet/a615_zap.mbn";
	};
};

&ipa {
	firmware-name = "qcom/sm7150/xiaomi/courbet/ipa_fws.mbn";
};

&i2c7 {
	clock-frequency = <100000>;
	status = "okay";

	/* qcom,pm8008 (pmic) @ 8 */
	/* qcom,pm8008 (pmic) @ 9 */

	speaker_top: audio-codec@34 {
		compatible = "nxp,tfa9873";
		reg = <0x34>;

		pinctrl-0 = <&spk_amp_reset_default &spk_amp_top_int_default &spk_sw_default>;
		pinctrl-names = "default";

		sound-name-prefix = "Top";
		#sound-dai-cells = <0>;
	};

	speaker_bottom: audio-codec@35 {
		compatible = "nxp,tfa9873";
		reg = <0x35>;
		nxp,tdm-speaker-slot = <1>;

		pinctrl-0 = <&spk_amp_bottom_int_default>;
		pinctrl-names = "default";

		sound-name-prefix = "Bottom";
		#sound-dai-cells = <0>;
	};

	/* st,fts (ts) @ 49 */
	/* goodix,gt9886 (ts) @ 5d */
};

&i2c9 {
	clock-frequency = <400000>;
	status = "okay";

	/* qcom,fsa4480 (usb switcher) @ 42 */

	haptics@5a {
		compatible = "awinic,aw8624";
		reg = <0x5a>;
		interrupts-extended = <&pm6150l_gpios 10 IRQ_TYPE_EDGE_FALLING>;
		reset-gpios = <&tlmm 4 GPIO_ACTIVE_HIGH>;

		pinctrl-0 = <&haptics_int_default &haptics_reset_default>;
		pinctrl-names = "default";

		awinic,f0-preset = <2050>;
		awinic,f0-coefficient = <260>;
		awinic,f0-calibration-percent = <7>;
		awinic,drive-level = <106>;

		awinic,f0-detection-play-time = <9>;
		awinic,f0-detection-wait-time = <5>;
		awinic,f0-detection-repeat = <1>;
		awinic,f0-detection-trace = <15>;

		awinic,tset = /bits/ 8 <0x11>;
		awinic,r-spare = /bits/ 8 <0x68>;

		awinic,bemf-upper-threshold = <0x8>;
		awinic,bemf-lower-threshold = <0x3f8>;
	};

	/* ti,bq25968 (charger) @ 66 */
};

&mdss {
	/delete-property/ resets;
};

&panel {
	compatible = "mdss,k9a-36-02-0a-mp-dsc";
};

&nfc_default {
	pins = "gpio12", "gpio31", "gpio36", "gpio100";
};

&nfc_sleep {
	pins = "gpio12", "gpio31", "gpio36", "gpio100";
};

&nxp {
	enable-gpios = <&tlmm 100 GPIO_ACTIVE_HIGH>;
};

&pm6150l_gpios {
	haptics_int_default: haptics-int-default-state {
		pins = "gpio10";
		function = PMIC_GPIO_FUNC_NORMAL;
		input-enable;
		bias-pull-up = <PMIC_GPIO_PULL_UP_31P5>;
		power-source = <1>;
	};
};

&pm6150_typec {
	connector {
		power-role = "dual";
		try-power-role = "sink";

		sink-pdos = <PDO_FIXED(5000, 3000, PDO_FIXED_DUAL_ROLE |
			     PDO_FIXED_USB_COMM | PDO_FIXED_DATA_SWAP)>;
		op-sink-microwatt = <10000000>;
	};
};

&q6afedai {
	dai@16 {
		reg = <PRIMARY_MI2S_RX>;
		qcom,sd-lines = <0>;
	};
};

&q6asmdai {
	dai@0 {
		reg = <MSM_FRONTEND_DAI_MULTIMEDIA1>;
	};
};

&remoteproc_adsp {
	firmware-name = "qcom/sm7150/xiaomi/courbet/adsp.mbn";
};

&remoteproc_cdsp {
	firmware-name = "qcom/sm7150/xiaomi/courbet/cdsp.mbn";
};

&remoteproc_mpss {
	firmware-name = "qcom/sm7150/xiaomi/courbet/modem.mbn";
};

&sdhc_2 {
	status = "okay";
};

&spi4 {
	status = "okay";

	touchscreen@0 {
		compatible = "goodix,gt9897";
		reg = <0>;
		spi-max-frequency = <8000000>;

		interrupts-extended = <&tlmm 9 IRQ_TYPE_LEVEL_LOW>;
		reset-gpios = <&tlmm 8 GPIO_ACTIVE_LOW>;

		avdd-supply = <&vreg_ts_avdd>;
		vddio-supply = <&vreg_ts_vddio>;

		pinctrl-0 = <&ts_int_active &ts_reset_active>;
		pinctrl-names = "default";

		touchscreen-size-x = <1080>;
		touchscreen-size-y = <2400>;
	};
};

&spi8 {
	clock-frequency = <19200000>;
	status = "okay";

	/* ir-spi @ 0 */
};

&tlmm {
	haptics_reset_default: haptics-reset-default-state {
		pins = "gpio4";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};

	spk_amp_bottom_int_default: spk-amp-bottom-int-default-state {
		pins = "gpio11";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-up;
	};

	spk_amp_reset_default: spk-amp-reset-default-state {
		pins = "gpio66";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-down;
		output-low;
	};

	spk_amp_top_int_default: spk-amp-top-int-default-state {
		pins = "gpio90";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-up;
	};

	spk_sw_default: spk-sw-default-state {
		pins = "gpio110";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-down;
		output-low;
	};
};

&uart8 {
	status = "disabled";
};

&venus {
	firmware-name = "qcom/sm7150/xiaomi/courbet/venus.mbn";
	status = "okay";
};

&wifi {
	firmware-name = "sm7150";
};
